{
  "name": "protracker",
  "version": "1.15.0",
  "description": "A lab project tracker: projects, milestones, goals, experiments and scaffold inventory over a dependency graph, stored as plain text.",
  "type": "module",
  "license": "MIT",
  "author": "Karim Ghabra",
  "main": "dist-electron/main.cjs",
  "bin": {
    "pt": "dist/cli/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ui && npm run build:electron",
    "build:ui": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build:ui && npm run test:e2e",
    "fieldtest": "vitest run tests/unit/fieldtest.test.ts",
    "stress": "vitest run --config vitest.stress.config.ts",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --publish never",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "pack:all": "npm run build && electron-builder --win --linux --publish never",
    "icon": "python scripts/make-icon.py",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "verify:pack": "npm run pack && npm run test:desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.karimghabra.protracker",
    "productName": "Protracker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-ui/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Protracker-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "guid": "94cd8365-54c5-558a-bdfd-d3e8a7f65912",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Protracker",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Protracker-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Protracker-${version}.${ext}",
      "icon": "build/icon.png",
      "maintainer": "Karim Ghabra"
    },
    "compression": "maximum"
  }
}
