{
  "productName": "protracker",
  "version": "0.4.0",
  "identifier": "com.protracker.dashboard",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "protracker",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "protracker dashboard",
    "longDescription": "Dashboard for protracker: project health, ready-task ranking by impact, workbook import and node creation. Self-contained -- the CLI is bundled, so no Python installation is required.",
    "externalBin": [
      "binaries/protracker-cli"
    ]
  }
}
