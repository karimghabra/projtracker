{
  "productName": "protracker",
  "version": "0.1.0",
  "identifier": "com.protracker.dashboard",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "protracker",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "protracker dashboard",
    "longDescription": "Desktop shell for the protracker CLI: project health, ready-task ranking by impact, and node creation. Requires Python and the protracker package on the same machine."
  }
}
